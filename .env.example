# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# TextBee SMS
TEXTBEE_DEVICE_ID=your-textbee-device-id
TEXTBEE_API_KEY=your-textbee-api-key

# SpeedSMS is deferred for this school project
SPEEDSMS_API_KEY=
SPEEDSMS_SENDER=DentalCare

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@dentalcare.vn
BREVO_SENDER_NAME=DentalCare

# Frontend URL
FRONTEND_URL=http://localhost:5173
